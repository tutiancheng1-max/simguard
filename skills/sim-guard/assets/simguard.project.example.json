{
  "simq_py": "simq/simq.py",
  "readonly_paths": ["runs_archive"],
  "approved_templates": ["templates"],
  "do_not_reuse_markers": ["DO_NOT_REUSE*"],
  "forbidden_patterns": [
    {
      "id": "example-rule",
      "glob": ["*.java", "*.py"],
      "regex": "oldHelperWithKnownBug\\(",
      "why": "说明为什么不能这样写，以及应该怎么写"
    }
  ],
  "readback_expect": [
    {"select": "*:physics/*/*/c", "op": "isotropic", "physics_op": ["CoefficientFormPDE"],
     "why": "本项目的扩散方程都是各向同性的"},
    {"select": "*:material/*/*/thermalconductivity", "op": "nonzero"}
  ],
  "builtin_readback": true,
  "required_report_checks": ["energy_balance"]
}
